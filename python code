import os
import streamlit as st
import pandas as pd
import numpy as np
import plotly.express as px

st.set_page_config(page_title="Swiggy Instamart EDA Dashboard", page_icon="⚡", layout="wide")

st.markdown("""
    <style>
    .main-title { font-size: 2.2rem; font-weight: 700; color: #FC8019; margin-bottom: 0.2rem; }
    .sub-title { font-size: 1.05rem; color: #686b78; margin-bottom: 1.5rem; }
    </style>
""", unsafe_allow_html=True)

st.markdown('<div class="main-title">⚡ Swiggy Instamart - Sales & Inventory EDA</div>', unsafe_allow_html=True)
st.markdown('<div class="sub-title">Live dark store telemetry, SKU depletion velocity, and fulfillment SLA analytics.</div>', unsafe_allow_html=True)

@st.cache_data
def load_and_prep_data():
    def get_path(fname):
        if os.path.exists(fname):
            return fname
        if os.path.exists(os.path.join('data', fname)):
            return os.path.join('data', fname)
        return fname

    orders = pd.read_csv(get_path('order_transactions.csv'))
    products = pd.read_csv(get_path('products.csv'))
    categories = pd.read_csv(get_path('categories.csv'))
    stores = pd.read_csv(get_path('stores.csv'))
    payments = pd.read_csv(get_path('payment_methods.csv'))
    
    # Left joins to prevent silent data loss from uncataloged stores
    df = (orders
          .merge(products, on='ProductID', how='left')
          .merge(categories, on='CategoryID', how='left')
          .merge(stores, on='StoreID', how='left')
          .merge(payments, on='PaymentMethodID', how='left'))
    
    df['NetRevenue'] = df['TotalPrice'] - df['DiscountApplied']
    df['OrderDate'] = pd.to_datetime(df['OrderDate'])
    df['DeliveryDate'] = pd.to_datetime(df['DeliveryDate'])
    df['CategoryName'] = df['CategoryName'].fillna('Uncategorized')
    return df, products, categories, stores

df, products, categories, stores = load_and_prep_data()

# Sidebar Filters
st.sidebar.header("🕹️ Filter Dashboard")
all_statuses = df['OrderStatus'].dropna().unique().tolist()
selected_status = st.sidebar.multiselect(
    "Order Status", 
    options=all_statuses, 
    default=all_statuses
)

all_categories = sorted(df['CategoryName'].dropna().unique().tolist())
selected_cat = st.sidebar.multiselect(
    "Product Category", 
    options=all_categories, 
    default=all_categories
)

# Apply Filters
filtered_df = df[(df['OrderStatus'].isin(selected_status)) & (df['CategoryName'].isin(selected_cat))]

# Bug Guard: Empty filter selection handling
if filtered_df.empty:
    st.warning("⚠️ No order records match the selected filters. Please select at least one Order Status and Product Category in the sidebar.")
    st.stop()

# Top Level KPI Row (Guarded against NaN)
kpi1, kpi2, kpi3, kpi4, kpi5 = st.columns(5)
total_gmv = filtered_df['TotalPrice'].sum()
total_orders = len(filtered_df)
units_dispatched = filtered_df['Quantity'].sum()
avg_order_value = filtered_df['TotalPrice'].mean()
avg_sla = filtered_df['DeliveryTimeMinutes'].mean()

with kpi1:
    st.metric("Total GMV", f"₹{total_gmv:,.0f}")
with kpi2:
    st.metric("Total Orders", f"{total_orders:,}")
with kpi3:
    st.metric("Units Dispatched", f"{units_dispatched:,}")
with kpi4:
    st.metric("Average Order Value", f"₹{avg_order_value:.1f}" if pd.notna(avg_order_value) else "₹0.0")
with kpi5:
    st.metric("Avg SLA (Mins)", f"{avg_sla:.1f}m" if pd.notna(avg_sla) else "0.0m")

st.markdown("---")

# Visual Grid: Revenue & Fulfillment Split
c1, c2 = st.columns([1.2, 1])
with c1:
    cat_sales = filtered_df.groupby('CategoryName')['TotalPrice'].sum().reset_index().sort_values(by='TotalPrice', ascending=True)
    fig_cat = px.bar(
        cat_sales, x='TotalPrice', y='CategoryName', orientation='h', 
        title="Revenue by Category (₹)", color='TotalPrice', color_continuous_scale='Oranges'
    )
    fig_cat.update_layout(height=380, margin=dict(l=20, r=20, t=40, b=20), showlegend=False)
    st.plotly_chart(fig_cat, use_container_width=True)

with c2:
    status_counts = filtered_df['OrderStatus'].value_counts().reset_index()
    status_counts.columns = ['OrderStatus', 'count']
    fig_pie = px.pie(
        status_counts, names='OrderStatus', values='count', 
        title="Fulfillment Status Split", hole=0.45, 
        color_discrete_sequence=px.colors.qualitative.Pastel
    )
    fig_pie.update_layout(height=380, margin=dict(l=20, r=20, t=40, b=20))
    st.plotly_chart(fig_pie, use_container_width=True)

# Visual Grid: Delivery SLA & Inventory Depletion Scatter
c3, c4 = st.columns([1, 1.2])
with c3:
    fig_sla = px.histogram(
        filtered_df, x='DeliveryTimeMinutes', nbins=15, 
        title="Delivery SLA Distribution (Minutes)", color_discrete_sequence=['#2a9d8f']
    )
    if pd.notna(avg_sla):
        fig_sla.add_vline(x=avg_sla, line_dash="dash", line_color="red", annotation_text=f"Mean SLA ({avg_sla:.1f}m)")
    fig_sla.update_layout(height=380, margin=dict(l=20, r=20, t=40, b=20))
    st.plotly_chart(fig_sla, use_container_width=True)

with c4:
    # Accurate SKU inventory aggregation: includes all products in selected categories (even 0-sales deadstock)
    cat_products = products.merge(categories[['CategoryID', 'CategoryName']], on='CategoryID', how='left')
    cat_products = cat_products[cat_products['CategoryName'].isin(selected_cat)]

    sales_per_sku = filtered_df.groupby('ProductID').agg(
        units_sold=('Quantity', 'sum'),
        sales=('TotalPrice', 'sum')
    ).reset_index()

    sku_agg = cat_products.merge(sales_per_sku, on='ProductID', how='left')
    sku_agg['units_sold'] = sku_agg['units_sold'].fillna(0).astype(int)
    sku_agg['sales'] = sku_agg['sales'].fillna(0.0)
    sku_agg['UnitPrice'] = sku_agg['UnitPrice'].fillna(10.0)

    # Division by zero guard
    sku_agg['Depletion_Ratio_%'] = np.where(
        sku_agg['StockQuantity'] > 0,
        ((sku_agg['units_sold'] / sku_agg['StockQuantity']) * 100).round(1),
        0.0
    )

    fig_scatter = px.scatter(
        sku_agg, x='StockQuantity', y='units_sold', size='UnitPrice', color='CategoryName',
        hover_name='ProductName', title="SKU Velocity: On-Hand Stock vs. Units Sold",
        labels={'StockQuantity': 'Warehouse Stock', 'units_sold': 'Units Sold'}
    )
    fig_scatter.update_layout(height=380, margin=dict(l=20, r=20, t=40, b=20), showlegend=False)
    st.plotly_chart(fig_scatter, use_container_width=True)

# Restock Tables
st.markdown("### 🚨 SKU Depletion & Restock Priorities")
st_t1, st_t2 = st.columns(2)
with st_t1:
    st.markdown("**High Depletion SKUs (Immediate Stockout Risk)**")
    high_dep = sku_agg.sort_values(by='Depletion_Ratio_%', ascending=False)[['ProductName', 'CategoryName', 'units_sold', 'StockQuantity', 'Depletion_Ratio_%']].head(5)
    st.dataframe(high_dep, hide_index=True, use_container_width=True)

with st_t2:
    st.markdown("**Overstocked SKUs (Working Capital Drag)**")
    low_dep = sku_agg.sort_values(by=['Depletion_Ratio_%', 'StockQuantity'], ascending=[True, False])[['ProductName', 'CategoryName', 'units_sold', 'StockQuantity', 'Depletion_Ratio_%']].head(5)
    st.dataframe(low_dep, hide_index=True, use_container_width=True)
